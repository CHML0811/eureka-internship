# .env.example — copy to .env and fill in real values.
# NEVER commit .env to version control.

# Offline-safe defaults. Opt in to local/private Ollama or AWS Textract explicitly.
LLM_PROVIDER=mock
TEXTRACT_PROVIDER=mock

# Self-hosted Llama model. All KYC/entity/document data stays on this private lane.
# The application rejects public hosts for this OpenAI-compatible Ollama endpoint.
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.1
LOCAL_VLM_MODEL=llama3.2-vision

# Required only when TEXTRACT_PROVIDER=aws. Prefer an AWS profile or workload
# identity; do not store long-lived credentials in this file.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-east-1

# Neo4j AuraDB Free — synthetic Project 9 demo data only.
# Never place real KYC, PII, client, or regulated data in the free-tier instance.
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
